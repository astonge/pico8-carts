pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	plyr=player:new()
	plyr:init()
	dpal={0,1,1,2,1,13,6,4,4,9,3,13,1,13,14}
	startgame()
end

function startgame()
	fadeperc=0.6
	wind={}
	hpwind=addwind(5,50,39,13,{})
	_drw=draw_game
	music(0,3000,4)
end

function draw_game()
	cls(0)
	map()
	plyr:draw()
end

function _update()
	plyr:update()
	if not stat(57) then
		music(0,0,4)
	end
end

function _draw()
	_drw()
	drawind()
	dohpwind()
	checkfade()	
end
-->8
--player
player={}
function player:new(tbl)
tbl = tbl or {}
setmetatable(tbl,{ __index = self})
return tbl
end
function player:init()
	self.r={x=0,y=0,x2=0,y2=0}
	self.l={x=0,y=0,x2=0,y2=0}
	self.u={x=0,y=0,x2=0,y2=0}
	self.d={x=0,y=0,x2=0,y2=0}
		
	self.x=1
	self.y=1
	self.sp={23,24}
	--tick,frame,step	
	self.t,self.f,self.s = 0,1,16
	self.state="idle"
	self.anime={
	idle={s=16,sp={23,24}},
	walk={s=6,sp={6,7}},
}
end

function player:draw()
--debug(self)
spr(self.anime[self.state].sp[self.f],self.x*8,self.y*8)
end

function player:update()
--lrud
self.r={
	x=(self.x+1)*8,y=self.y*8,
	x2=((self.x+1)*8)+8,y2=((self.y+1)*8)
}
self.l={
	x=(self.x-1)*8,y=self.y*8,
	x2=((self.x-1)*8)+8,y2=((self.y+1)*8)
}
self.u={
	x=self.x*8,y=(self.y*8)-8,
	x2=((self.x+1)*8),y2=((self.y+1)*8)-8
}
self.d={
	x=self.x*8,y=(self.y*8)+8,
	x2=((self.x+1)*8),y2=((self.y+1)*8)+8
}
--anime
self.t=(self.t+1)%self.anime[self.state].s
if (self.t==0) self.f=self.f%#self.anime[self.state].sp+1
--buttons	
if not btn(❎) and not btn(🅾️) then
	if btnp(⬆️) do
		if canmov(self.u) then
			self.y-=1
		end
	end
	if btnp(⬇️) do
		if canmov(self.d) then
			self.y+=1
		end
	end
	if btnp(➡️) do
		if canmov(self.r) then
			self.x+=1
		end
	end
	if btnp(⬅️) do
		if canmov(self.l) then
			self.x-=1
		end
	end
end
--action buttons
if btn(🅾️) then
	if btnp(➡️) do action(self.r) end
	if btnp(⬅️) do action(self.l) end
	if btnp(⬆️) do action(self.u) end
	if btnp(⬇️) do action(self.d) end
end
--end of update
end

function player:addinv(thing)
	printh("adding "..thing.." to inv")
end

function action(dir)
	if canget(dir,tree.id) then
		-- tree
		sfx(1)
		tree.update(dir)
	elseif canget(dir,wood.id) then
		-- wood
		sfx(1)
		wood.update(dir)
	else
		sfx(0)
	end
end

function canget(d,kind)
	if mget(d.x/8,d.y/8) == kind do
		return true
	end
	return false
end

function debug(s)
rect(s.r.x,s.r.y,s.r.x2,s.r.y2,10)
rect(s.l.x,s.l.y,s.l.x2,s.l.y2)
rect(s.u.x,s.u.y,s.u.x2,s.u.y2)
rect(s.d.x,s.d.y,s.d.x2,s.d.y2)
end
-->8
--collisions
function isblocked(tile)
	return fget(tile,0)
end

function canmov(d)
	if d.x<0 or d.y<0 then
		return false
	end
	if d.x>120 or d.y>120 then
		return false
	end
	return not isblocked(mget(d.x/8,d.y/8))
end
