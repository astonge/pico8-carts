pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	p_init()
	dpal={0,1,1,2,1,13,6,4,4,9,3,13,1,13,14}
	startgame()
	plyr:init()
end

function startgame()
	fadeperc=0.6
	wind={}
	hpwind=addwind(5,50,39,13,{})
	_upd=update_game
	_drw=draw_game
	music(0,3000,4)
end

function update_game()
end

function draw_game()
	cls(0)
	map()
	p_draw()
end

function _update()
	p_update()
	plyr:update()
	if not stat(57) then
		music(0,0,4)
	end
end

function _draw()
	_drw()
	drawind()
	dohpwind()
	checkfade()
--	rectfill(0,128-16,128,128,0)
--	rect(0,127-16,127,127,5)	

end
