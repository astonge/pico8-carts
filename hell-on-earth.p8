--collisions
function isblocked(tile)
	return fget(tile,0)
end

function canmov(d)
	printh(d.x)
	printh(d.y)
	if d.x<0 or d.y<0 then
		return false
	end
	if d.x>450 or d.y>250 then
		return false
	end
	return not isblocked(mget(d.x/8,d.y/8))
end
