local pdone=false
local f=0
local sfade=0
local	start_done=false

function intro()
	cls(0)
	wait(15)
	-- bunny 1
	sspr(24,32,16,15,64,64)
	draw_text()
 rectfill(64-14,64+19+sfade,64+32,64+32,0)
	wait(40)
	while start_done==false do
		startup()
		sfade+=0.3
		cls(0)
	end
	wait(3)
end

function startup()
	sspr(24,32,16,15,64,64)
	draw_text()
	rectfill(64-14,(64+19)+sfade,64+32,64+32,0)
	wait(0.32)
	if (sfade>13) do
		cls(0)
		sspr(40,32,16,15,64,64)
		draw_text()
		wait(2)
		cls(0)
		sspr(56,32,16,15,64,64)
		draw_text()
		wait(50)
		start_done=true
	end
end

