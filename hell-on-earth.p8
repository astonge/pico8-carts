function _init()
	plyr=player:new()
	plyr:init()
	dpal={0,1,1,2,1,13,6,4,4,9,3,13,1,13,14}
	npcs={}
	add(npcs,makenpc(6,6,"camper"))
	add(npcs,makenpc(7,4,"hiker"))
--	intro()
	title=explode64(tspr)
	_draw = draw_title()
	startgame()
end

function draw_title()
	cls()
	spr_rle(title,0,0)
	cprint("press ❎",nil,110,{0})
end

function startgame()
	fadeperc=0.6
	wind={}
	hpwind=addwind(5,50,39,13,{})
	_drw=draw_game
	music(0,3000,4)
end

function draw_game()
	cls(0)
	cam_x=(plyr:getx()*8)-60
 cam_y=(plyr:gety()*8)-60
 cam_x=mid(0,cam_x,896)
 cam_y=mid(0,cam_y,128)
 camera(cam_x,cam_y)
	map(0,0,0,0,128,128)
	npc_draw()
	plyr:draw()
end

function _update()
	npc_update()
	plyr:update()

	if not stat(57) then
		music(0,0,4)
	end
end

function _draw()
	_drw()
	camera(0,0)
	drawind()
	dohpwind()
	checkfade()	
end
