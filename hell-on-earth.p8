--player
player={}
t=0
function player:new(tbl)
tbl = tbl or {}
setmetatable(tbl,{ __index = self})
return tbl
end
function player:init()
	self.r={x=0,y=0,x2=0,y2=0}
	self.l={x=0,y=0,x2=0,y2=0}
	self.u={x=0,y=0,x2=0,y2=0}
	self.d={x=0,y=0,x2=0,y2=0}
		
	self.flts={}
		
	self.x=1
	self.y=1
	self.state="idle"
	--tick,frame,step	
	self.t,self.f = 0,1
	self.anime={
		idle={s=22,sp={23,24}},
		mup={s=10,sp={7,8}},
		mdn={s=10,sp={7,9}},
		mlt={s=10,sp={7,24}},
		mrt={s=10,sp={7,23}},
}
end

function player:getx()
return self.x
end
function player:gety()
return self.y
end

function player:draw()
--debug(self)
spr(
	self.anime[self.state]
		.sp[self.f],
	self.x*8,self.y*8
)
self:drawflt()
end

function player:update()
--lrud
self.r={
	x=(self.x+1)*8,y=self.y*8,
	x2=((self.x+1)*8)+8,y2=((self.y+1)*8)
}
self.l={
	x=(self.x-1)*8,y=self.y*8,
	x2=((self.x-1)*8)+8,y2=((self.y+1)*8)
}
self.u={
	x=self.x*8,y=(self.y*8)-8,
	x2=((self.x+1)*8),y2=((self.y+1)*8)-8
}
self.d={
	x=self.x*8,y=(self.y*8)+8,
	x2=((self.x+1)*8),y2=((self.y+1)*8)+8
}
--anime
self.t=(self.t+1)%self.anime[self.state].s
if (self.t==0) self.f=self.f%#self.anime[self.state].sp+1
--after 60 frames of non idle
--switch back to idle
if self.state~="idle" then
	t=t+1
	if t%60==0 then
		self.state="idle"
		t=0
	end
end

--floats
self.updateflt()

--buttons	
if not btn(❎) and not btn(🅾️) then
	if btnp(⬆️) do
		if canmov(self.u) then
			self.state="mup"
			self.y-=1
		end
	end
	if btnp(⬇️) do
		if canmov(self.d) then
			self.state="mdn"
			self.y+=1
		end
	end
	if btnp(➡️) do
		if canmov(self.r) then
			self.state="mrt"
			self.x+=1
		end
	end
	if btnp(⬅️) do
		if canmov(self.l) then
			self.state="mlt"
			self.x-=1
		end
	end
end
--action buttons
if btn(🅾️) then
	if btnp(➡️) do action(self.r) end
	if btnp(⬅️) do action(self.l) end
	if btnp(⬆️) do action(self.u) end
	if btnp(⬇️) do action(self.d) end
end
if btn(❎) then
	if btnp(➡️) do sfx(0) end
	if btnp(⬅️) do sfx(0) end
	if btnp(⬆️) do sfx(0) end
	if btnp(⬇️) do sfx(0) end
end
--end of update
end

function player:addinv(thing)
	printh("adding "..thing.." to inv")
end

function player:addflt(flt)
--	printh("adding flt "..flt)
	add(self.flts,flt)
end

function player:updateflt()
	if #plyr.flts>0 then
		for f in all(plyr.flts) do
--			printh(plyr.y*8)
--			printh("f.y "..f.y)
			if f.y<(plyr.y*8)-6 then
				del(plyr.flts,f)
			else
				f.y-=1
				f.r-=0.5
			end
		end
	end
end

function player:drawflt()
	for f in all(plyr.flts) do
		circfill(f.x,f.y,f.r,f.c)
	end
end

function action(dir)
	plyr:addflt({
		x=(plyr.x*8)+4,
		y=plyr.y*8,
		r=4,
		c=7
	})

	if canget(dir,tree.id) then
		-- tree
		sfx(1)
		tree.update(dir)
	elseif canget(dir,wood.id) then
		-- wood
		sfx(1)
		wood.update(dir)
	else
		sfx(0)
	end
end

function canget(d,kind)
	if mget(d.x/8,d.y/8) == kind do
		return true
	end
	return false
end

function debug(s)
rect(s.r.x,s.r.y,s.r.x2,s.r.y2,10)
rect(s.l.x,s.l.y,s.l.x2,s.l.y2)
rect(s.u.x,s.u.y,s.u.x2,s.u.y2)
rect(s.d.x,s.d.y,s.d.x2,s.d.y2)
end
